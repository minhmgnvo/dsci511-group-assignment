    "import requests\n",
    "import pandas as pd\n",
    "\n",
    "response = requests.get(\n",
    "  \"https://api.openf1.org/v1/car_data\",\n",
    "  params={\"driver_number\": 1, \"session_key\": 9158}\n",
    ")\n",
    "\n",
    "df = pd.DataFrame(response.json())\n",
    "print(f\"Rows returned: {len(df)}\")\n",
    "df.head(10)"
   ]
